// Schema Prisma. Base PostgreSQL (migration depuis SQLite effectuee pour
// RG-PIL-04 du pack : role DB analytics_reader limite a un schema separe,
// impossible sous SQLite qui n'a pas de systeme de schemas/roles). PostGIS
// n'est pas encore active : les champs de geolocalisation restent des Float
// simples (latitude/longitude), a revoir si F-PIL-03 (carte sanitaire) exige
// de vraies requetes geospatiales. Les champs qui seraient des tableaux
// natifs restent stockes en chaine JSON (compatibilite conservee avec le
// modele de donnees existant, pas une contrainte Postgres).

generator client {
  provider = "prisma-client-js"
}

// RG-PIL-04 du pack : le schema "analytics" est physiquement separe du
// schema "public" pour pouvoir limiter un role de base de donnees dedie
// (analytics_reader, voir prisma/analytics-role.sql) au seul schema
// "analytics" : GRANT USAGE/SELECT sur analytics, aucun droit sur public.
// Cote Prisma, "multiSchema" (stable depuis 5.15) permet de declarer les
// deux schemas dans le meme client tout en gardant une isolation reelle au
// niveau de la base, verifiee par un test (voir prisma/analytics-role.sql et
// le test d'integration associe).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "analytics"]
}

// Compte utilisateur de la plateforme, tous roles confondus.
// Correspond a User dans src/types/domain-identity.ts.
model User {
  id                String    @id @default(cuid())
  nom               String
  prenom            String
  email             String    @unique
  telephone         String
  motDePasseHash    String
  statut            String    @default("actif")
  dateCreation      DateTime  @default(now())
  derniereConnexion DateTime?
  // Chemin public (/uploads/avatars/...) de la photo de profil televersee.
  // Null tant que l'utilisateur n'a jamais televerse de photo : l'ecran
  // affiche alors une image neutre par defaut, jamais des initiales.
  avatarUrl         String?
  // Secret TOTP (base32), present uniquement si la double authentification a
  // ete activee. Jamais expose tel quel a l'ecran apres l'activation initiale.
  mfaSecret         String?
  // Vrai une fois la double authentification confirmee (code valide saisi a
  // l'activation). mfaSecret peut exister sans mfaActif=true pendant la
  // fenetre d'activation (avant confirmation du premier code).
  mfaActif          Boolean   @default(false)
  // F-AUTH-01 (RG-AUTH-07) : version du texte des conditions d'utilisation acceptees
  // a l'inscription et date d'acceptation. Null pour un compte cree avant cette regle.
  conditionsVersion     String?
  conditionsAccepteesLe DateTime?

  roles         UserRole[]
  patient       Patient?
  professionnel ProfessionnelSante?
  journalAudit  JournalAudit[]
  demandesAccesDossier DemandeAccesDossier[]
  // Consentements ou cet utilisateur est l'acteur autorise par un patient
  // (typiquement un professionnel de sante), pas ses propres consentements.
  consentementsRecus Consentement[]
  evenementsPrescription EvenementPrescription[]
  notifications Notification[]
  preferencesNotification PreferenceNotification[]
  addendaConsultation AddendumConsultation[]
  documentsMedicaux DocumentMedical[]
  codesVerificationEmail CodeVerificationEmail[]
  codesReinitialisationMotDePasse CodeReinitialisationMotDePasse[]
  sessionsActives SessionActive[]
  codesSecoursMfa CodeSecoursMfa[]
  revuesAccesUrgence RevueAccesUrgence[]
  alertesRevues HealthAlertReview[]
  traitementsDemandesPersonnes TraitementDemandePersonne[]
  signalementsAnomalies SignalementAnomalieAcces[] @relation("UtilisateurSignale")
  signalementsRevises SignalementAnomalieAcces[] @relation("ReviewerSignalement")
  @@schema("public")
}

// Attribution d'un role a un utilisateur (un utilisateur peut cumuler
// plusieurs roles). nom correspond au type NomRole.
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nom    String

  @@unique([userId, nom])
  @@schema("public")
}

// Referentiel geographique du Benin (12 departements, communes reelles),
// pour la dimension territoire des indicateurs de pilotage (chapitre 14 du
// pack : "Territoires : national -> departement (12) -> zone sanitaire (34)
// -> commune -> etablissement"). Departements et communes sont des donnees
// administratives reelles et stables. Les zones sanitaires (regroupements
// officiels de communes, 34 au Benin) sont en revanche seedees de facon
// minimale ici (une par etablissement de demo connu) : la liste complete et
// les decoupages exacts doivent etre valides aupres du ministere avant tout
// usage reel, meme limite deja assumee pour les referentiels allergies et
// vaccins de ce depot.
model Departement {
  id   String @id @default(cuid())
  code String @unique
  nom  String @unique

  communes        Commune[]
  zonesSanitaires ZoneSanitaire[]

  @@schema("public")
}

model ZoneSanitaire {
  id            String @id @default(cuid())
  code          String @unique
  nom           String
  departementId String
  departement   Departement @relation(fields: [departementId], references: [id])

  etablissements EtablissementSanitaire[]

  @@schema("public")
}

model Commune {
  id            String @id @default(cuid())
  nom           String
  departementId String
  departement   Departement @relation(fields: [departementId], references: [id])

  etablissements EtablissementSanitaire[]

  @@unique([departementId, nom])
  @@schema("public")
}

// Correspond a EtablissementSanitaire dans src/types/domain-facility.ts.
model EtablissementSanitaire {
  id                  String @id @default(cuid())
  // Identifiant public court, prefixe "BJ-ETB-" (meme convention que
  // Patient.identifiantSante et ProfessionnelSante.numeroProfessionnel) :
  // permet d'identifier un etablissement sans exposer son cuid interne.
  identifiant         String @unique
  nom                 String
  type                String
  localisation        String
  latitude            Float
  longitude           Float
  servicesDisponibles String @default("[]")
  capacite            Int
  // Dimension territoire des indicateurs de pilotage (F-PIL-02/03, RG-PIL-05).
  // Facultatifs pour ne pas casser les etablissements deja crees avant ce
  // referentiel ; un etablissement sans territoire renseigne est exclu des
  // agregats territorialises tant qu'il n'est pas complete.
  communeId       String?
  commune         Commune? @relation(fields: [communeId], references: [id])
  zoneSanitaireId String?
  zoneSanitaire   ZoneSanitaire? @relation(fields: [zoneSanitaireId], references: [id])

  // Champs F-ADM-02 du pack ("Gerer le referentiel des etablissements"),
  // tous facultatifs pour ne pas casser les etablissements deja crees avant
  // cet enrichissement (meme principe que communeId/zoneSanitaireId
  // ci-dessus). RG-ADM-01/02 : statut de cycle de vie, jamais de suppression
  // (voir fermerEtablissementAction, src/modules/administration/etablissements.ts).
  sigle                    String?
  // central | intermediaire | peripherique
  niveauPyramide           String?
  // public | prive_lucratif | prive_confessionnel | associatif
  secteur                  String?
  arrondissement           String?
  quartierVillage          String?
  adresse                  String?
  telephoneEtablissement   String?
  emailEtablissement       String?
  // Code de l'etablissement dans DHIS2, facultatif (aucune integration
  // DHIS2 reelle dans ce depot, uniquement le champ de reference).
  identifiantExterneDhis2  String?
  // brouillon | actif | suspendu | ferme (traduction de DRAFT/ACTIVE/SUSPENDED/CLOSED)
  statut                   String   @default("brouillon")
  etablissementParentId    String?
  etablissementParent      EtablissementSanitaire?  @relation("HierarchieEtablissement", fields: [etablissementParentId], references: [id])
  etablissementsEnfants    EtablissementSanitaire[] @relation("HierarchieEtablissement")

  professionnels ProfessionnelSante[]
  rendezVous     RendezVous[]
  consultations  Consultation[]
  demandesAccesDossier DemandeAccesDossier[]
  affiliationsProfessionnelles AffiliationProfessionnelle[]
  // Examens medicaux dont cet etablissement est le laboratoire assigne
  // (uniquement pertinent pour un etablissement de type "laboratoire").
  examensMedicaux ExamenMedical[]
  suivisCommunautaires SuiviCommunautaire[]
  personnesCommunautaires PersonneCommunautaire[]
  vaccinations Vaccination[]
  prisesEnChargeInfirmieres PriseEnChargeInfirmiere[]
  delivrances Delivrance[]
  // F-CLI-14 : cet etablissement comme origine (references envoyees par ses
  // medecins) ou comme destination (references recues, base d'acces
  // temporaire pour ses medecins).
  referencesEnvoyeesDepuis ReferencePatient[] @relation("EtablissementOrigineReference")
  referencesRecues         ReferencePatient[] @relation("EtablissementDestinationReference")
  @@schema("public")
}

// Correspond a ProfessionnelSante dans src/types/domain-identity.ts.
// Extension metier d'un User, jamais de donnee medicale ici.
model ProfessionnelSante {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialite          String
  numeroProfessionnel String @unique
  etablissementId     String
  etablissement       EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  statutValidation    String @default("en_attente")
  // Identite professionnelle nationale (RG-AUTH-42 du pack) : profession +
  // numero d'inscription a l'Ordre, uniques ensemble. Facultatifs : les profils
  // existants n'ont pas encore ce numero, et Postgres autorise plusieurs NULL
  // sous une contrainte unique. Le numero d'ordre est un identifiant public,
  // pas un authentifiant : il ne prouve pas que celui qui le saisit en est
  // titulaire (voir docs/recherche-transfert/identite-professionnels.md).
  profession          String?
  numeroOrdre         String?
  // F-ADM-03 : verification humaine du numero aupres de l'Ordre par le
  // validateur du ministere (procedure manuelle hors plateforme). Null = jamais
  // verifie ; une verification de plus d'un an est a renouveler (revalidation
  // periodique). ordreVerifiePar = userId du validateur.
  ordreVerifieLe      DateTime?
  ordreVerifiePar     String?
  // Derniere decision du validateur : approuve | refuse | complement. Le
  // message est le motif du refus ou le complement demande. L'historique
  // complet est dans JournalAudit.
  validationDecision  String?
  validationMessage   String?
  validationDecideLe  DateTime?
  affiliations        AffiliationProfessionnelle[]
  @@unique([profession, numeroOrdre])

  rendezVous    RendezVous[]
  consultations Consultation[]
  prescriptions Prescription[]
  // Examens medicaux demandes par ce professionnel (typiquement un medecin).
  examensDemandes ExamenMedical[]
  // F-CLI-14 : references vers un autre etablissement envoyees par ce
  // professionnel (medecin referent), et contre-references qu'il a redigees
  // en reponse a une reference recue par son etablissement.
  referencesEnvoyees ReferencePatient[] @relation("MedecinReferent")
  contreReferencesRedigees ReferencePatient[] @relation("AuteurContreReference")
  // F-CIT-11 : codes de partage temporaires de patients consommes par ce
  // professionnel (medecin ou infirmier valide, RG-CIT-91).
  codesPartageConsommes CodePartageDossier[]
  // F-LAB-04 : examens dont ce professionnel a saisi le resultat / qu'il a valides (role laboratoire).
  examensSaisis  ExamenMedical[] @relation("ExamenSaisiPar")
  examensValides ExamenMedical[] @relation("ExamenValidePar")
  examensPreleves ExamenMedical[] @relation("ExamenPreleve")
  // Visites de suivi communautaire menees par ce professionnel (role agent_communautaire).
  suivisCommunautaires SuiviCommunautaire[]
  personnesEnregistrees PersonneCommunautaire[]
  vaccinations Vaccination[]
  prisesEnChargeInfirmieres PriseEnChargeInfirmiere[]
  delivrances Delivrance[]
  // F-ETA-05 : creneaux hebdomadaires recurrents de disponibilite.
  creneauxDisponibilite CreneauDisponibilite[]
  @@schema("public")
}

// Correspond a Patient dans src/types/domain-patient.ts.
// Phase 3 : dossier patient (antecedents, allergies, maladies chroniques,
// consentement). Les champs de type liste sont stockes en chaine JSON
// (SQLite ne supporte pas les listes scalaires Prisma).
model Patient {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifiantSante            String   @unique
  // NPI (13 chiffres, chiffres seuls). Unique : deux dossiers ne peuvent pas
  // revendiquer la meme personne (aide aussi a reperer les doublons). Tout
  // traitement d'un NPI exige l'autorisation prealable de l'APDP (art. 407 du
  // Code du numerique) : voir la fonctionnalite activable "access.by_npi".
  referenceIdentiteNationale  String?  @unique
  dateNaissance               DateTime
  sexe                        String
  groupeSanguin               String   @default("inconnu")
  contactsUrgence             String   @default("[]")
  allergies                   String   @default("[]")
  antecedents                 String   @default("[]")
  maladiesChroniques          String   @default("[]")
  // Declaratif, sans distinction DECLARED/CONFIRMED (meme simplification que
  // les champs ci-dessus) : utilise par le controle de securite "grossesse"
  // de la prescription (F-PRE-02, src/modules/prescription/controles-securite.ts).
  // Pas le modele "pregnancies" complet du pack (dates, historique) : un
  // booleen suffit pour ce controle, a etendre si un vrai suivi de grossesse
  // est un jour construit.
  grossesseEnCours            Boolean  @default(false)

  consentements Consentement[]
  rendezVous    RendezVous[]
  consultations Consultation[]
  prescriptions Prescription[]
  examensMedicaux ExamenMedical[]
  // Optionnel : un beneficiaire de visite communautaire n'a pas forcement de
  // dossier Patient enregistre (voir SuiviCommunautaire.beneficiaireNom).
  suivisCommunautaires SuiviCommunautaire[]
  vaccinations Vaccination[]
  documentsMedicaux DocumentMedical[]
  prisesEnChargeInfirmieres PriseEnChargeInfirmiere[]
  references ReferencePatient[]
  codesPartage CodePartageDossier[]
  codesReclamation CodeReclamationDossier[]
  demandesAccesDossier DemandeAccesDossier[]
  jetonsCarteSante JetonCarteSante[]
  @@index([dateNaissance])
  @@schema("public")
}

// Correspond a Consentement dans src/types/domain-patient.ts.
// Autorisation qu'un patient accorde a un acteur (ici un professionnel de
// sante) pour acceder a tout ou partie de son dossier. Le patient doit
// pouvoir l'accorder puis le retirer a tout moment (voir src/security/README.md).
model Consentement {
  id                 String    @id @default(cuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  acteurAutoriseId   String
  acteurAutorise     User      @relation(fields: [acteurAutoriseId], references: [id])
  typeAcces          String
  dateDebut          DateTime  @default(now())
  dateFin            DateTime?
  statut             String    @default("actif")

  // Une seule ligne par couple (patient, acteur) : accorder de nouveau apres
  // un retrait met a jour cette meme ligne (statut + dates), plutot que
  // d'empiler des lignes. L'historique des evenements vit dans JournalAudit.
  @@unique([patientId, acteurAutoriseId])
  @@schema("public")
}

// Correspond a RendezVous dans src/types/domain-facility.ts.
// Le patient choisit un etablissement et, optionnellement, un professionnel
// precis. Prendre rendez-vous n'exige pas de consentement prealable (aucune
// donnee clinique n'est echangee a cette etape) : seule la consultation qui
// en decoule, plus tard, en exige un (voir Consultation ci-dessous).
model RendezVous {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  professionnelId String?
  professionnel   ProfessionnelSante? @relation(fields: [professionnelId], references: [id])
  date            DateTime
  motif           String
  statut          String    @default("demande")
  dateCreation    DateTime  @default(now())
  // F-RDV-07 du pack (RG-RDV-50/52) : horodatage d'envoi de chaque rappel,
  // null tant qu'il n'a pas ete envoye. Empeche un double envoi (le
  // planificateur ne renvoie jamais un rappel deja marque), et un rendez-vous
  // annule (statut "annule") est simplement exclu de la recherche des
  // rappels dus, sans mecanisme d'annulation dedie.
  rappelVeilleEnvoyeLe      DateTime?
  rappelDeuxHeuresEnvoyeLe  DateTime?
  // F-RDV-04/05 du pack (RG-RDV-33/40) : horodatage de l'arrivee, null tant
  // que le patient n'est pas arrive. Distingue confirme-pas-arrive
  // d'arrive-en-attente sans nouveau modele "Visite" (perimetre reduit
  // documente dans src/modules/facility/file-du-jour.ts). Le statut
  // "absent" (nouvelle valeur possible de statut, toujours une chaine
  // libre ici) est pose automatiquement par la tache planifiee du meme
  // module quand l'heure est depassee de plus d'1h sans arrivee.
  heureArrivee              DateTime?
  // RG-RDV-11 : nombre de deplacements successifs. Le rendez-vous qui remplace
  // l'ancien herite de son compte + 1 ; au-dela de 2, il faut annuler et reprendre.
  nombreDeplacements        Int       @default(0)
  // F-RDV-03 : motif du refus par l'etablissement (statut "refuse"), transmis
  // au patient. Null pour tous les autres statuts.
  motifRefus                String?

  consultation Consultation?
  // RG-RDV-03 : index UNIQUE PARTIEL "RendezVous_professionnelId_date_actif_key"
  // sur (professionnelId, date) WHERE professionnelId IS NOT NULL AND statut NOT
  // IN ('annule', 'refuse', 'expire') : un rendez-vous annule, refuse ou expire
  // libere le creneau (migrations 20260926213000_unicite_rendez_vous_actif puis
  // 20260927040000_regles_rendez_vous). Prisma ne sait pas l'exprimer : il
  // n'apparait pas ici. Verifie : `prisma migrate diff` reste vide et ne
  // propose pas de le supprimer (le commentaire contraire de la premiere
  // migration est inexact, ce fichier n'est pas modifie car sa somme de
  // controle est deja enregistree en base).
  // Le statut ne s'ecrit que par src/modules/facility/rendez-vous-etats.ts.
  @@schema("public")
}

// Correspond a Consultation dans src/types/domain-clinical.ts.
// Cree par un professionnel de sante, uniquement si un Consentement actif
// (typeAcces "dossier_complet" ou "consultations") existe pour ce couple
// (patient, professionnel) : verifie cote module, pas au niveau du schema.
model Consultation {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionnelId String
  professionnel   ProfessionnelSante @relation(fields: [professionnelId], references: [id])
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  rendezVousId    String?   @unique
  rendezVous      RendezVous? @relation(fields: [rendezVousId], references: [id])
  date            DateTime  @default(now())
  motif           String    @default("")
  symptomes       String    @default("[]")
  // Constantes vitales structurees (F-CLI-06 du pack) : chaque champ est
  // facultatif (toutes les constantes ne sont pas toujours prises), verifie
  // par src/modules/clinical/controles-constantes.ts avant enregistrement
  // (plage acceptee = refus, plage d'alerte = confirmation demandee).
  temperatureCelsius    Float?
  pouls                 Int?
  tensionSystolique     Int?
  tensionDiastolique    Int?
  frequenceRespiratoire Int?
  saturationOxygene     Int?
  poidsKg               Float?
  tailleCm              Float?
  glycemieGL            Float?
  observations    String    @default("")
  conclusion      String    @default("")
  // F-CLI-05/07 du pack : cycle de vie brouillon -> valide (RG-CLI-40 : un
  // seul brouillon ouvert par patient et par medecin). "terminee" designe la
  // consultation validee (verrouillee, immuable hors addendum), jamais un
  // statut de rendez-vous.
  statut          String    @default("brouillon")
  dateValidation  DateTime?
  // Empreinte SHA-256 du contenu clinique canonique au moment de la
  // validation (F-CLI-07), calculee par calculerEmpreinteConsultation dans
  // src/modules/clinical/actions.ts.
  empreinteContenu String?
  // F-CLI-08 / RG-CLI-70 du pack : retrait ("saisie par erreur"), reserve au
  // cas d'une consultation enregistree sur le mauvais patient. La
  // consultation reste visible (barree a l'ecran) mais exclue des
  // statistiques ; jamais une suppression.
  saisieParErreur Boolean   @default(false)
  motifRetrait    String?
  dateRetrait     DateTime?

  prescriptions Prescription[]
  examensMedicaux ExamenMedical[]
  addenda         AddendumConsultation[]
  documentsMedicaux DocumentMedical[]
  priseEnChargeInfirmiere PriseEnChargeInfirmiere?
  references      ReferencePatient[]
  @@schema("public")
}

// F-CLI-08 du pack : complement ou correction d'une consultation deja
// validee, jamais une modification du contenu original (immuabilite,
// RG-CLI-00). Toujours affiche sous la consultation, date et signe par son
// auteur.
model AddendumConsultation {
  id             String   @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  auteurId       String
  auteur         User     @relation(fields: [auteurId], references: [id])
  // complement_information | correction | resultat_recu | autre
  motif          String
  contenu        String
  date           DateTime @default(now())
  @@schema("public")
}

// Correspond a ExamenMedical dans src/types/domain-clinical.ts.
// Demande par un professionnel de sante (typiquement un medecin), realise par
// un etablissement de type "laboratoire". Comme pour Consultation, la
// demande exige un Consentement actif pour le patient concerne : verifie
// cote module, pas au niveau du schema. Le rattachement a une consultation
// d'origine est optionnel (un examen peut aussi etre demande hors
// consultation formelle, ex. suivi programme).
model ExamenMedical {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  demandeurId     String
  demandeur       ProfessionnelSante @relation(fields: [demandeurId], references: [id])
  laboratoireId   String
  laboratoire     EtablissementSanitaire @relation(fields: [laboratoireId], references: [id])
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id])
  typeExamen      String
  // F-LAB-01 du pack : numero de demande lisible LB-XXXX-XXXX, tire au hasard
  // (jamais un compteur, donc aucune course a la creation) avec contrainte
  // d'unicite et nouvel essai en cas de collision. Facultatif : les examens
  // crees avant cette colonne n'ont pas de numero.
  numero          String?   @unique
  date            DateTime  @default(now())
  // demande | en_cours | resultat_saisi | correction_demandee | termine | annule
  // F-LAB-04 / RG-ROL-30 (principe des quatre yeux) : "resultat_saisi" est un
  // etat intermediaire, pas encore visible en dehors du laboratoire
  // (RG-LAB-30) ; seule la validation par un AUTRE professionnel de
  // laboratoire fait passer a "termine". Ce depot n'a pas de role
  // LAB_SUPERVISOR distinct : la validation est ouverte a tout professionnel
  // du role laboratoire autre que celui ayant saisi le resultat.
  statut          String    @default("demande")
  resultat        String?
  // F-LAB-03 du pack : resultat structure par parametre (tableau JSON de
  // { code, valeur, unite, indicateur }), pour le sous-ensemble d'examens
  // quantitatifs couverts par
  // src/modules/laboratoire/referentiel-parametres-examens.ts. Colonne
  // additive : les examens hors de ce perimetre reduit continuent d'utiliser
  // uniquement `resultat` (texte libre), inchange, jamais les deux a la fois.
  resultatsParametres Json?
  dateResultat    DateTime?
  saisiParId      String?
  saisiPar        ProfessionnelSante? @relation("ExamenSaisiPar", fields: [saisiParId], references: [id])
  valideParId     String?
  validePar       ProfessionnelSante? @relation("ExamenValidePar", fields: [valideParId], references: [id])
  dateValidation  DateTime?
  // Empreinte SHA-256 du resultat au moment de la validation (meme principe
  // que Consultation.empreinteContenu et Prescription.empreinteContenu).
  empreinteResultat     String?
  // Motif de renvoi pour correction (RG-ROL-31), efface a la validation.
  commentaireValidation String?
  // F-LAB-02 / RG-LAB-02 du pack : un examen "sensible" (ex. serologie VIH) a
  // son resultat masque au patient tant qu'un medecin ne l'a pas annonce, voir
  // src/modules/laboratoire/referentiel-examens-sensibles.ts.
  sensible                  Boolean @default(false)
  resultatAnnonceAuPatient  Boolean @default(false)

  // F-LAB-02 du pack ("Recevoir la demande et enregistrer le prelevement").
  // Etape ajoutee entre la demande et la saisie de resultat : le technicien
  // verifie l'identite du patient puis enregistre le prelevement, ce qui
  // fait passer le statut de "demande" a "en_cours" (valeur deja prevue dans
  // le commentaire ci-dessus mais jamais ecrite par aucun code avant ce
  // chantier). Voir enregistrerPrelevementAction/rejeterEchantillonAction,
  // src/modules/laboratoire/actions.ts.
  identiteVerifiee       Boolean   @default(false)
  datePrelevement        DateTime?
  // sang_veineux | sang_capillaire | urine | selles | autre
  typeEchantillon        String?
  identifiantEchantillon String?
  preleveurId            String?
  preleveur              ProfessionnelSante? @relation("ExamenPreleve", fields: [preleveurId], references: [id])
  // Rejet d'echantillon (hemolyse, quantite insuffisante, mauvais tube,
  // delai depasse, etiquetage incorrect) : remet le statut a "demande" pour
  // un nouveau prelevement, sans jamais effacer la trace du rejet precedent
  // (conserve ici, l'historique complet vit dans JournalAudit).
  motifRejetEchantillon  String?

  // F-LAB-01 du pack : renseignes a la demande par le medecin prescripteur.
  // "normal" | "urgent" (RG-LAB-40, priorite affichee au laboratoire, pas de
  // delai de traitement automatise dans ce MVP). aJeunRequis est affiche au
  // patient (pour se presenter a jeun) et au laboratoire (pour verifier avant
  // le prelevement), jamais impose techniquement (aucun controle bloquant).
  niveauUrgence   String  @default("normal")
  aJeunRequis     Boolean @default(false)

  // F-LAB-04 / RG-ROL-31 du pack : numero de la version courante du resultat
  // (1 a la premiere validation). Une correction d'un resultat deja valide
  // archive l'ancienne version dans VersionResultatExamen puis incremente ce
  // numero ; la version archivee n'est jamais modifiee.
  versionResultat Int @default(1)
  versionsResultat VersionResultatExamen[]

  // RG-LAB-41 / N-LAB-ANNOUNCE-OVERDUE du pack : date du rappel envoye au
  // prescripteur quand le resultat d'un examen sensible valide n'a pas ete
  // annonce au patient sous 30 jours (voir src/modules/laboratoire/relances.ts).
  // Un seul rappel par version de resultat.
  relanceAnnonceLe DateTime?

  @@schema("public")
}

// F-LAB-04 / RG-ROL-31 du pack : un resultat valide NE DOIT PAS etre modifie,
// une correction cree une nouvelle version avec motif. Cette table conserve,
// figee, chaque version VALIDEE remplacee (valeurs, empreinte, validateur), le
// motif de la correction et son auteur ; ExamenMedical porte toujours la
// version courante. Jamais mise a jour ni supprimee par le code.
model VersionResultatExamen {
  id                  String   @id @default(cuid())
  examenId            String
  examen              ExamenMedical @relation(fields: [examenId], references: [id], onDelete: Cascade)
  numero              Int
  resultat            String?
  resultatsParametres Json?
  empreinteResultat   String?
  saisiParId          String?
  valideParId         String?
  dateValidation      DateTime?
  motifCorrection     String
  corrigeParId        String
  dateCorrection      DateTime @default(now())

  @@unique([examenId, numero])
  @@schema("public")
}

// Correspond a SuiviCommunautaire dans src/types/domain-communautaire.ts.
// Visite de terrain menee par un agent communautaire (role agent_communautaire) :
// vaccination, depistage, suivi de grossesse ou sensibilisation aupres d'un
// beneficiaire, qui n'a pas toujours de dossier Patient enregistre sur la
// plateforme (patientId reste alors nul, beneficiaireNom porte l'identite).
model SuiviCommunautaire {
  id              String    @id @default(cuid())
  agentId         String
  agent           ProfessionnelSante @relation(fields: [agentId], references: [id])
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  patientId       String?
  patient         Patient?  @relation(fields: [patientId], references: [id])
  // F-COM-02 du pack : lien optionnel vers une fiche personne enregistree
  // (voir PersonneCommunautaire ci-dessous), distinct de patientId (jamais
  // rempli, un dossier Patient exigerait un compte User que
  // agent_communautaire n'a pas le droit de creer, voir
  // src/modules/communautaire/actions.ts). beneficiaireNom reste toujours
  // rempli (copie du nom de la personne si personneId est fourni), aucun
  // ecran d'affichage existant n'a besoin d'etre modifie.
  personneId      String?
  personne        PersonneCommunautaire? @relation(fields: [personneId], references: [id])
  beneficiaireNom String
  // vaccination | depistage | suivi_grossesse | sensibilisation | autre
  typeVisite      String
  dateVisite      DateTime  @default(now())
  localisation    String    @default("")
  notes           String    @default("")
  dateCreation    DateTime  @default(now())
  @@schema("public")
}

// Correspond a F-COM-02 du pack ("Enregistrer une personne") : fiche dediee
// pour un beneficiaire suivi par un agent communautaire, jamais un dossier
// Patient (qui exigerait un compte User, hors du perimetre RBAC
// d'agent_communautaire, voir le commentaire de SuiviCommunautaire
// ci-dessus et src/modules/communautaire/actions.ts). Perimetre reduit
// assume par rapport au pack : detection de doublon par correspondance
// exacte normalisee (nom, prenom, date de naissance), pas un score de
// similarite ; portee etablissement (tous les agents du meme etablissement
// partagent le meme registre), pas de mode hors ligne ni de statut REVIEW
// distinct (ce depot n'a pas d'infrastructure de synchronisation).
model PersonneCommunautaire {
  id              String    @id @default(cuid())
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  agentId         String
  agent           ProfessionnelSante @relation(fields: [agentId], references: [id])
  nom             String
  prenom          String
  dateNaissance   DateTime
  // Coche "date approximative" du pack (F-CLI-03) : la date de naissance
  // saisie est une estimation ("environ 35 ans"), jamais une date d'etat
  // civil exacte.
  dateNaissanceApproximative Boolean @default(false)
  sexe            String
  villageQuartier String
  chefMenage      String?
  dateCreation    DateTime  @default(now())
  visites         SuiviCommunautaire[]
  @@schema("public")
}

// Correspond a Medicament dans src/types/domain-clinical.ts.
// Referentiel de medicaments, independant d'une prescription precise.
model Medicament {
  id                          String @id @default(cuid())
  nom                          String
  principeActif                String
  dosage                        String
  forme                          String
  // Classe therapeutique (ex. "penicillines"), utilisee par le controle de
  // securite allergie <-> medicament (F-PRE-02 / RG-PRE-10 du pack), voir
  // src/modules/prescription/referentiel-allergies.ts. Chaine libre pour ce
  // MVP plutot qu'une table de classes ATC dediee.
  classeTherapeutique           String @default("")
  informationsComplementaires   String @default("")
  // Controles de securite F-PRE-02 / RG-PRE-02 du pack. Null = aucune
  // restriction connue pour ce medicament (pas "sans risque", juste "non
  // renseigne" : meme convention que classeTherapeutique vide plus haut).
  ageMinimumMois                Int?
  contreIndiqueGrossesse        Boolean @default(false)
  // F-ADM-04 (referentiel medicaments administrable) : RG-ADM-20, on
  // desactive une entree, on ne la supprime jamais (deja utilisee par de
  // vraies LignePrescription). Actif par defaut pour ne jamais masquer les
  // medicaments de demo deja seedes ce soir.
  actif                          Boolean @default(true)

  lignesPrescription LignePrescription[]
  // Generique par lequel ce medicament a ete substitue lors d'une delivrance (F-PHA-03).
  substitutionsDelivrees LigneDelivrance[] @relation("MedicamentDelivre")
  @@schema("public")
}

// Correspond a Prescription dans src/types/domain-clinical.ts.
// Toujours rattachee a une Consultation et a un professionnel identifie
// (regle metier du cahier des charges, Partie 3 section 4). patientId est
// denormalise depuis la consultation pour simplifier les requetes du
// dossier patient, mais reste toujours coherent avec consultation.patientId
// (verifie cote module a la creation, jamais modifie ensuite).
model Prescription {
  id                    String   @id @default(cuid())
  consultationId        String
  consultation          Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medecinPrescripteurId String
  medecinPrescripteur   ProfessionnelSante @relation(fields: [medecinPrescripteurId], references: [id])
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                  DateTime @default(now())
  // creee | validee | delivree_partiellement | delivree | annulee
  // Phase 5 : le medecin cree directement une prescription "validee" (il a
  // examine le patient). Les statuts delivree/delivree_partiellement relevent
  // du module pharmacie, hors perimetre de cette phase (voir README).
  statut                String   @default("validee")
  instructions          String   @default("")
  // Numero d'ordonnance lisible (F-PRE-04 du pack), format RX-XXXX-XXXX,
  // genere a la creation. Empreinte SHA-256 du contenu canonique (lignes,
  // instructions), calculee au meme moment : la prescription est deja creee
  // "validee" dans ce MVP (voir commentaire ci-dessus), donc numero et
  // empreinte sont fixes des la creation plutot qu'a une signature separee.
  numero                String   @unique
  empreinteContenu      String

  lignes     LignePrescription[]
  historique EvenementPrescription[]
  delivrances Delivrance[]
  @@schema("public")
}

// Correspond a LignePrescription dans src/types/domain-clinical.ts : un
// medicament du catalogue avec sa posologie pour cette prescription precise.
model LignePrescription {
  id                   String @id @default(cuid())
  prescriptionId       String
  prescription         Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicamentId         String
  medicament           Medicament @relation(fields: [medicamentId], references: [id])
  posologie            String
  quantite             Int
  dureeTraitementJours Int
  // RG-PHA-12 du pack : une ligne marquee non substituable ne peut jamais
  // recevoir un generique a la delivrance, meme de meme DCI/dosage/forme.
  nonSubstituable      Boolean @default(false)

  lignesDelivrees LigneDelivrance[]
  @@schema("public")
}

// Correspond a F-PHA-03 du pack : un acte de delivrance en pharmacie, une ou
// plusieurs lignes a la fois. Immuable (RG-PHA-13) : une erreur se corrige
// par une annulation motivee dans les 24h qui restitue les quantites,
// jamais une modification des lignes deja creees.
model Delivrance {
  id              String   @id @default(cuid())
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacienId    String
  pharmacien      ProfessionnelSante @relation(fields: [pharmacienId], references: [id])
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  date            DateTime @default(now())
  annulee         Boolean  @default(false)
  motifAnnulation String?
  dateAnnulation  DateTime?

  lignes LigneDelivrance[]
  @@schema("public")
}

// Une ligne delivree au sein d'un acte de delivrance (Delivrance) : quantite
// reellement remise au patient pour une LignePrescription donnee, produit
// delivre (identique ou substitue par un generique de meme DCI/dosage/forme,
// jamais si LignePrescription.nonSubstituable), motif si quantite nulle ou
// partielle (rupture de stock, refus du patient, cout, autre).
model LigneDelivrance {
  id                  String   @id @default(cuid())
  delivranceId        String
  delivrance          Delivrance @relation(fields: [delivranceId], references: [id], onDelete: Cascade)
  lignePrescriptionId String
  lignePrescription   LignePrescription @relation(fields: [lignePrescriptionId], references: [id])
  quantiteDelivree    Int
  medicamentDelivreId String?
  medicamentDelivre   Medicament? @relation("MedicamentDelivre", fields: [medicamentDelivreId], references: [id])
  motifNonDelivrance  String?
  numeroLot           String?
  datePeremption      DateTime?
  @@schema("public")
}

// Correspond a EvenementHistoriquePrescription dans src/types/domain-clinical.ts.
// Historique obligatoire du cycle de vie d'une prescription (creation,
// modification, validation, delivrance).
model EvenementPrescription {
  id             String   @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  type           String
  date           DateTime @default(now())
  utilisateurId  String
  utilisateur    User     @relation(fields: [utilisateurId], references: [id])
  commentaire    String?
  @@schema("public")
}

// Code de verification a 6 chiffres envoye par e-mail a chaque connexion
// (etape obligatoire, independante de la double authentification TOTP
// optionnelle ci-dessus, voir loginAction dans src/modules/identity/actions.ts).
// Jamais le code en clair : seul son empreinte bcrypt est stockee, meme
// principe que User.motDePasseHash. A usage unique (consommeLe) et de courte
// duree de vie (expireLe), comme le jeton de pre-authentification JWT associe.
model CodeVerificationEmail {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  dateCreation DateTime @default(now())
  expireLe    DateTime
  consommeLe  DateTime?
  @@schema("public")
}

// F-AUTH-04 du pack : code de reinitialisation de mot de passe, envoye par
// e-mail. Table dediee plutot que reutiliser CodeVerificationEmail : les deux
// codes ont des consequences tres differentes s'ils sont devoilés (verifier
// une connexion deja mot-de-passe-authentifiee, contre changer le mot de
// passe sans autre verification) ; les melanger dans la meme table aurait
// risque qu'un code de connexion valide soit accepte par erreur pour
// reinitialiser le mot de passe (ou l'inverse) si les deux existent en meme
// temps pour le meme compte. Meme principe sinon que CodeVerificationEmail :
// jamais le code en clair stocke, usage unique, courte duree de vie.
model CodeReinitialisationMotDePasse {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  dateCreation DateTime  @default(now())
  expireLe     DateTime
  consommeLe   DateTime?
  @@schema("public")
}

// Correspond a F-AUTH-03 du pack ("Reclamer un dossier existant") : code
// permettant au titulaire d'un dossier Patient cree "sans compte" (F-CLI-03,
// src/modules/identity/actions.ts) d'activer lui-meme ce compte. RG-AUTH-20 :
// code jamais stocke en clair, usage unique, valide 30 jours, 5 tentatives
// maximum puis blocage (l'etablissement peut en regenerer un nouveau,
// simplement en creant une nouvelle ligne, l'ancienne restant bloquee).
model CodeReclamationDossier {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  codeHash     String
  tentatives   Int       @default(0)
  dateCreation DateTime  @default(now())
  expireLe     DateTime
  consommeLe   DateTime?
  @@schema("public")
}

// Correspond a JournalAudit dans src/types/domain-audit.ts.
// Trace obligatoire de toute action sensible (connexion, deconnexion...).
// RG-AUD-02 du pack : "chaque trace contient l'empreinte de la trace
// precedente (chainage) ; une page Verifier l'integrite recalcule la chaine
// sur une periode et signale toute rupture." empreinte/empreintePrecedente
// sont calcules par un trigger Postgres (voir la migration
// ajout_chainage_journal_audit, fonction chainer_journal_audit) au moment de
// l'insertion, jamais par le code applicatif : ainsi TOUTE ecriture dans
// cette table est chainee, y compris une eventuelle requete SQL directe qui
// contournerait journaliser() (src/modules/audit/journaliser.ts, point
// d'ecriture unique cote application, mais le trigger est le vrai garant,
// pas cette convention de code seule). numeroSequence (auto-incremente)
// donne un ordre total fiable independant de `date` (deux ecritures
// concurrentes peuvent partager la meme milliseconde, jamais le meme
// numero de sequence).
model JournalAudit {
  id               String   @id @default(cuid())
  utilisateurId    String
  utilisateur      User     @relation(fields: [utilisateurId], references: [id])
  action           String
  donneeConcernee  String
  date             DateTime @default(now())
  adresseTechnique String
  justification    String
  numeroSequence   BigInt   @default(autoincrement()) @unique
  // Empreinte SHA-256 de (empreintePrecedente ?? "") + id + utilisateurId +
  // action + donneeConcernee + justification. Jamais fournies par le code
  // applicatif (absentes de DonneesJournalAudit) : toujours calculees par le
  // trigger, quel que soit le chemin d'ecriture.
  empreinte            String?
  empreintePrecedente  String?

  revue RevueAccesUrgence?
  traitementDemande TraitementDemandePersonne?
  @@schema("public")
}

// Correspond a F-AUD-02 du pack : revue d'un acces d'urgence "bris de glace"
// (src/modules/urgence/actions.ts) par un administrateur. Table separee
// plutot qu'un champ ajoute sur JournalAudit : une trace d'audit reste
// immuable, la revue est un evenement distinct qui la concerne, jamais une
// modification de l'entree originale.
model RevueAccesUrgence {
  id             String   @id @default(cuid())
  journalAuditId String   @unique
  journalAudit   JournalAudit @relation(fields: [journalAuditId], references: [id])
  reviewerId     String
  reviewer       User     @relation(fields: [reviewerId], references: [id])
  // conforme | non_conforme
  decision       String
  commentaire    String
  date           DateTime @default(now())
  @@schema("public")
}

// Notification interne (Phase 10). Correspond au perimetre "notifications
// internes" documente dans src/modules/notification/README.md : uniquement
// le canal in-app pour cette phase, pas de SMS ni d'email reel (aucune
// passerelle disponible pour ce MVP).
model Notification {
  id            String   @id @default(cuid())
  utilisateurId String
  utilisateur   User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          String
  message       String
  lien          String?
  lu            Boolean  @default(false)
  date          DateTime @default(now())
  // RG-LAB-21 du pack : date de l'escalade d'une notification de resultat
  // critique restee non lue plus de 2 h (voir src/modules/laboratoire/relances.ts).
  // Sert de reclamation : une notification n'est escaladee qu'une fois.
  escaladeLe    DateTime?
  @@schema("public")
}

// Correspond a F-NOT-03 du pack ("Preferences de notification") : pour
// chaque categorie modifiable (voir src/modules/notification/categories.ts),
// l'utilisateur choisit les canaux SMS/email (le canal interne est toujours
// actif, jamais stocke ici). RG-NOT-10 : les categories "securite" et
// "codes" ne peuvent jamais etre desactivees, elles n'ont donc aucune ligne
// dans cette table (etat fixe, non modifiable). Une ligne absente pour une
// categorie modifiable equivaut a SMS/email desactives (valeur par defaut).
model PreferenceNotification {
  id            String  @id @default(cuid())
  utilisateurId String
  utilisateur   User    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  // rendez_vous | resultats_documents | traitements | acces_dossier | informations_generales
  categorie     String
  sms           Boolean @default(false)
  email         Boolean @default(false)
  @@unique([utilisateurId, categorie])
  @@schema("public")
}

// Correspond a F-NOT-02 du pack ("Envoi de SMS, adaptateur") : boite
// d'envoi simulee ("sms_outbox" dans le pack), remplie par
// OutboxSmsProvider (src/modules/notification/sms/provider.ts). Aucun
// fournisseur SMS reel dans ce depot (HttpSmsProvider est P2 dans le pack
// lui-meme) : chaque envoi est reellement ecrit ici et consultable
// (/app/ministere/sms), mais aucun SMS n'atteint reellement un telephone.
// RG-NOT-02 : le champ `texte` est deja forme (prefixe "BHIP : ", 160
// caracteres maximum, translitteration) au moment de l'ecriture, jamais
// reforme a la lecture. `destinataire` est le numero complet (necessaire
// pour un futur vrai fournisseur) : seul l'affichage (ecran /dev) le
// masque, jamais la valeur stockee.
model EnvoiSms {
  id             String    @id @default(cuid())
  destinataire   String
  texte          String
  // rendez_vous | resultats_documents | traitements | acces_dossier |
  // informations_generales | securite | codes (les 7 categories de
  // src/modules/notification/categories.ts, y compris les 2 verrouillees :
  // un envoi peut concerner une categorie sans preference modifiable).
  categorie      String
  // simule | differe (RG-NOT-04 : SMS non urgent envoye entre 21h et 7h,
  // reporte a 7h00 - la remise effective a 7h n'est pas automatisee dans ce
  // depot, aucune tache planifiee fiable, voir limite documentee dans
  // src/modules/notification/sms/envoyer.ts).
  statut         String    @default("simule")
  dateProgrammee DateTime?
  modele         String?
  cout           Float?
  dateEnvoi      DateTime  @default(now())
  @@schema("public")
}

// Correspond a F-CLI-11 du pack : vaccination administree en etablissement
// (calendrier PEV, section 18.4). Immuable une fois enregistree (RG-CLI-100) :
// une erreur de saisie se corrige par un retrait motive, jamais une
// modification ni une suppression.
model Vaccination {
  id                 String   @id @default(cuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionnelId    String
  professionnel      ProfessionnelSante @relation(fields: [professionnelId], references: [id])
  etablissementId    String
  etablissement      EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  vaccin             String
  numeroDose         Int
  dateAdministration DateTime
  numeroLot          String
  siteInjection      String
  voie               String
  saisieParErreur    Boolean  @default(false)
  motifRetrait       String?
  dateCreation       DateTime @default(now())
  @@schema("public")
}

// Correspond a F-CLI-13 du pack : document ajoute au dossier d'un patient
// (compte rendu, resultat, imagerie, courrier, certificat...). RG-CLI-112 :
// stocke hors du dossier public, jamais servi par une URL statique directe.
// RG-CLI-113 : jamais supprime, seulement retire "ajoute par erreur".
model DocumentMedical {
  id                     String    @id @default(cuid())
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  auteurId               String
  auteur                 User      @relation(fields: [auteurId], references: [id])
  consultationId         String?
  consultation           Consultation? @relation(fields: [consultationId], references: [id])
  type                   String
  titre                  String
  dateDocument           DateTime
  niveauConfidentialite  String    @default("normal")
  cheminFichier          String
  nomFichierOriginal     String
  typeMime               String
  tailleOctets           Int
  retirePourErreur       Boolean   @default(false)
  motifRetrait           String?
  dateCreation           DateTime  @default(now())
  @@schema("public")
}

// Correspond a F-CLI-12 du pack : prise en charge infirmiere (constantes,
// priorite de tri, note de soins) avant la consultation medicale. Ne cree
// jamais de Consultation (l'infirmier n'a pas cette permission) : le medecin
// recupere la prise en charge non consommee la plus recente du patient pour
// pre-remplir les constantes de sa propre consultation.
model PriseEnChargeInfirmiere {
  id                    String   @id @default(cuid())
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  infirmierId           String
  infirmier             ProfessionnelSante @relation(fields: [infirmierId], references: [id])
  etablissementId       String
  etablissement         EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  prioriteTri           String
  temperatureCelsius    Float?
  pouls                 Int?
  tensionSystolique     Int?
  tensionDiastolique    Int?
  frequenceRespiratoire Int?
  saturationOxygene     Int?
  poidsKg               Float?
  tailleCm              Float?
  glycemieGL            Float?
  noteSoins             String   @default("")
  // en_attente | recuperee (par le medecin dans sa consultation)
  statut                String   @default("en_attente")
  consultationRattacheeId String? @unique
  consultationRattachee   Consultation? @relation(fields: [consultationRattacheeId], references: [id])
  date                  DateTime @default(now())
  @@schema("public")
}

// Correspond a F-CLI-14 du pack (reference vers un autre etablissement, P2 :
// "non developpe dans le MVP", implemente ici a la demande explicite de
// l'utilisateur). Le medecin referent cree une fiche de reference (motif,
// niveau d'urgence, resume clinique) vers un etablissement de destination de
// niveau superieur (concretement : type "hopital", faute de champ "niveau
// dans la pyramide" dans ce depot, voir EtablissementSanitaire). Cette ligne
// sert elle-meme de base d'acces temporaire (30 jours a partir de la
// creation, champ dateFinAcces) : tout professionnel du role medecin de
// l'etablissement destinataire peut alors consulter le resume et l'historique
// du patient (src/modules/clinical/actions.ts, accesPatientAutorise), meme
// principe que l'acces d'urgence (src/modules/urgence/actions.ts) mais scope
// a un etablissement entier plutot qu'a un seul professionnel, puisque le
// medecin qui repondra n'est pas connu a l'avance. La contre-reference
// (compte-rendu du specialiste) cloture la reference sans jamais modifier ni
// supprimer les champs d'origine (meme principe d'immuabilite que
// AddendumConsultation).
model ReferencePatient {
  id                         String    @id @default(cuid())
  patientId                  String
  patient                    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId             String
  consultation               Consultation @relation(fields: [consultationId], references: [id])
  medecinReferentId          String
  medecinReferent            ProfessionnelSante @relation("MedecinReferent", fields: [medecinReferentId], references: [id])
  etablissementOrigineId     String
  etablissementOrigine       EtablissementSanitaire @relation("EtablissementOrigineReference", fields: [etablissementOrigineId], references: [id])
  etablissementDestinationId String
  etablissementDestination   EtablissementSanitaire @relation("EtablissementDestinationReference", fields: [etablissementDestinationId], references: [id])
  motif                      String
  // urgente | programmee
  niveauUrgence               String
  resumeClinique              String
  // ouverte | cloturee
  statut                      String    @default("ouverte")
  dateCreation                DateTime  @default(now())
  // Fin de la base d'acces temporaire accordee a l'etablissement destinataire.
  dateFinAcces                DateTime
  contreReferenceTexte        String?
  contreReferenceAuteurId     String?
  contreReferenceAuteur       ProfessionnelSante? @relation("AuteurContreReference", fields: [contreReferenceAuteurId], references: [id])
  dateContreReference         DateTime?
  dateCloture                 DateTime?

  @@index([etablissementDestinationId, statut])
  @@index([medecinReferentId])
  @@schema("public")
}

// Correspond au point 1 de F-PIL-07 du pack ("chaque evenement metier
// pertinent... publie un evenement dans une file de taches") : file de
// taches persistee en base plutot qu'en memoire, pour ne perdre aucun
// evenement en cas de redemarrage du serveur entre deux passages de la tache
// horaire. Une ligne = un evenement a traiter au prochain recalcul du couple
// (date, etablissement) concerne (src/modules/pilotage/agregation.ts).
model TachePilotage {
  id              String    @id @default(cuid())
  // Jour concerne par l'evenement (ex. date de la consultation validee), pas
  // la date de l'evenement de publication lui-meme (dateCreation ci-dessous).
  date            DateTime
  // Null si l'evenement ne porte pas de dimension etablissement (ex. compte
  // citoyen cree, IND-13).
  etablissementId String?
  // consultation_validee | consultation_retiree | rendez_vous_change |
  // prescription_signee | delivrance | vaccination | compte_cree
  type            String
  dateCreation    DateTime  @default(now())
  traitee         Boolean   @default(false)
  dateTraitement  DateTime?

  @@index([traitee])
  @@schema("public")
}

// Correspond a F-PIL-07 du pack (calcul des agregats) : table de faits
// unique, schema "analytics" separe (RG-PIL-04), une ligne par combinaison
// (jour, etablissement/zone/departement, indicateur, sexe, tranche d'age,
// dimension libre). RG-PIL-01 : jamais un identifiant de patient, un nom, ni
// une date de naissance exacte ici, uniquement des dimensions agregees et un
// compte. Le recalcul (src/modules/pilotage/agregation.ts) supprime puis
// reinsere les lignes d'un (date, etablissementId) donne dans une
// transaction (RG-PIL-60, idempotent). etablissementId est null pour un
// agregat calcule directement au niveau departemental/national (RG-PIL-05 :
// une donnee SENSITIVE n'est jamais comptee par etablissement ni par
// commune, seulement departement ou national).
model AgregatQuotidien {
  id                String   @id @default(cuid())
  date              DateTime
  etablissementId   String?
  zoneSanitaireId   String?
  departementId     String?
  typeEtablissement String?
  // Code IND-01 a IND-13 (catalogue documente dans src/modules/pilotage/indicateurs.ts).
  indicateur        String
  sexe              String?
  trancheAge        String?
  // Dimension supplementaire dependant de l'indicateur : groupe de maladies
  // (IND-03/04), DCI d'un medicament (IND-09), "vaccin:doseN" (IND-10),
  // statut de rendez-vous (IND-07), etc. Documente par indicateur dans
  // src/modules/pilotage/indicateurs.ts.
  dimensionLibre    String?
  valeur            Int
  dateCalcul        DateTime @default(now())

  @@unique([date, etablissementId, zoneSanitaireId, departementId, indicateur, sexe, trancheAge, dimensionLibre], name: "cle_agregat")
  @@index([indicateur, date])
  @@schema("analytics")
}

// Correspond a F-PIL-06 du pack (alertes epidemiologiques) : table de
// decisions humaines sur une alerte statistique, volontairement HORS du
// schema "analytics" (qui reste en lecture seule pour l'application, seul le
// job de recalcul y ecrit) : "nouvelle" -> "vue" (commentaire) -> "fermee"
// (motif). RG-PIL-50 : une alerte est un signal a verifier, jamais une
// communication automatique.
model HealthAlertReview {
  id              String    @id @default(cuid())
  zoneSanitaireId String
  groupeMaladies  String
  // Semaine ISO au format "AAAA-Wss", ex. "2026-W39".
  semaine         String
  casObserves     Int
  seuilCalcule    Float
  // nouvelle | vue | fermee
  statut          String    @default("nouvelle")
  commentaire     String?
  motifFermeture  String?
  reviewerId      String?
  reviewer        User?     @relation(fields: [reviewerId], references: [id])
  dateCreation    DateTime  @default(now())
  dateRevue       DateTime?

  @@unique([zoneSanitaireId, groupeMaladies, semaine])
  @@schema("public")
}

// Correspond a F-CIT-11 du pack ("Partager son dossier par code temporaire") :
// le patient genere un code court (8 caracteres sans caracteres ambigus,
// RG-CIT-90), qu'un professionnel medecin ou infirmier valide (RG-CIT-91)
// saisit pour obtenir lui-meme un Consentement "consultations" sur ce
// patient, sans que celui-ci ait besoin de le chercher dans une liste.
// Jamais le code en clair stocke (empreinte bcrypt), meme principe que
// CodeVerificationEmail. consommeParId/consommeLe permettent d'afficher
// "Partage avec Dr X" en temps quasi reel cote ecran patient (sondage
// periodique, voir src/modules/partage/actions.ts).
model CodePartageDossier {
  id            String    @id @default(cuid())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  codeHash      String
  dateCreation  DateTime  @default(now())
  expireLe      DateTime
  consommeLe    DateTime?
  consommeParId String?
  consommePar   ProfessionnelSante? @relation(fields: [consommeParId], references: [id])

  @@schema("public")
}

// Lien entre UNE personne professionnelle et UN etablissement (equivalent de
// PractitionerRole en FHIR, RG-ROL-02 du pack). Un professionnel qui exerce dans
// plusieurs etablissements a une ligne par etablissement, sans jamais dupliquer
// la personne. Etape A de la migration (docs/conception-transfert-dossier.md,
// section 8) : ecrite a chaque creation de profil et rétro-remplie depuis
// ProfessionnelSante.etablissementId, mais rien ne la LIT encore : l'etablissement
// utilise partout reste ProfessionnelSante.etablissementId tant que l'espace actif
// n'existe pas. Aucun flux ne cree encore plus d'une affiliation par personne.
model AffiliationProfessionnelle {
  id              String                 @id @default(cuid())
  professionnelId String
  professionnel   ProfessionnelSante     @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  etablissementId String
  etablissement   EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  // Meme vocabulaire que UserRole.nom.
  roleNom         String
  service         String?
  // invitee | active | suspendue | terminee. Creee "active" pour l'instant : aucun
  // flux d'invitation n'existe, l'administrateur d'etablissement recrute directement.
  statut          String                 @default("active")
  dateDebut       DateTime               @default(now())
  dateFin         DateTime?
  inviteParUserId String?

  @@index([professionnelId, statut])
  @@index([etablissementId, statut])
  @@schema("public")
}

// Acces au dossier d'un patient sans relation prealable, par NPI ou par
// telephone + date de naissance, confirme par un code envoye au patient (voir
// docs/conception-transfert-dossier.md). Une ligne par demande, y compris
// quand aucun patient ne correspond (patientId null) : la reponse faite au
// professionnel est identique dans les deux cas (RG-CLI-10), et ces lignes
// servent au comptage anti-balayage. Jamais le code en clair, ni le NPI ni le
// telephone saisis : uniquement leurs empreintes (RG-CLI-11).
model DemandeAccesDossier {
  id               String                 @id @default(cuid())
  demandeurId      String
  demandeur        User                   @relation(fields: [demandeurId], references: [id])
  etablissementId  String
  etablissement    EtablissementSanitaire @relation(fields: [etablissementId], references: [id])
  patientId        String?
  patient          Patient?               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // npi | telephone
  modeRecherche    String
  empreinteCritere String
  // consultation | avis_specialise | suite_de_soins | hospitalisation
  motif            String
  dureeAccesHeures Int
  codeHash         String
  tentatives       Int                    @default(0)
  renvois          Int                    @default(0)
  // en_attente | valide | refusee | expire | bloque
  statut           String                 @default("en_attente")
  // whatsapp | sms_simule | aucun : renseigne apres l'envoi, jamais montre au professionnel
  canal            String?
  dateCreation     DateTime               @default(now())
  expireLe         DateTime
  valideLe         DateTime?

  @@index([demandeurId, dateCreation])
  @@index([patientId, dateCreation])
  @@schema("public")
}

// Correspond a F-ADM-07 du pack ("Parametres et fonctionnalites activables").
// Un nombre parametrable du document (duree de validite, limite, seuil),
// avec ses bornes et sa valeur par defaut : la valeur effective utilisee par
// l'application, jamais seulement la valeur par defaut. RG-ADM-50 : chaque
// modification prend effet sans redemarrage (lue en base a chaque appel,
// jamais mise en cache en memoire) et est journalisee (voir
// modifierParametreAction, src/modules/administration/parametres.ts).
//
// Perimetre honnete de ce depot : l'infrastructure (table, ecran, RBAC,
// journalisation) est complete, mais aucune constante existante du code
// (ex. DUREE_VALIDITE_MINUTES dans verification-email.ts, ROUNDS_BCRYPT,
// duree d'acces de ReferencePatient) n'a ete migree pour LIRE sa valeur
// depuis cette table : ce sont encore des constantes fixes ailleurs dans le
// code. Reste a faire, fichier par fichier, si ce systeme doit vraiment
// piloter le comportement de l'application plutot que d'exister a cote.
model Parametre {
  id               String   @id @default(cuid())
  cle              String   @unique
  valeur           Float
  valeurDefaut     Float
  borneMin         Float
  borneMax         Float
  description      String
  dateModification DateTime @default(now())

  @@schema("public")
}

// Fonctionnalite activable (feature flag). RG-IA-02 : toute fonctionnalite
// d'IA doit se trouver derriere l'une de ces entrees, desactivee par defaut
// en production. Les cles du catalogue MVP (section 15 du pack) sont semees
// par provisionnerFonctionnalitesParDefaut() a la premiere lecture plutot
// que par un script de seed distinct (voir src/modules/administration/parametres.ts) :
// evite de dependre de prisma/seed.ts, deja modifie par ailleurs ce soir.
model FonctionnaliteActivable {
  id               String   @id @default(cuid())
  cle              String   @unique
  actif            Boolean  @default(false)
  description      String
  dateModification DateTime @default(now())

  @@schema("public")
}

// Correspond a F-AUD-04 du pack ("Traiter les demandes des personnes") :
// decision d'un administrateur sur une demande de rectification
// (JournalAudit.action = "demande_rectification", voir
// src/modules/patient/droits-donnees.ts) ou un signalement d'acces suspect
// (action = "signalement_acces_suspect", voir signalerAccesSuspectAction
// dans src/modules/patient/actions.ts). Les deux sont deja routees vers
// admin_national (pas de role AUDITOR dans ce depot). Meme principe que
// RevueAccesUrgence : jamais une modification de l'entree JournalAudit
// d'origine, une reponse est un evenement distinct qui la concerne.
model TraitementDemandePersonne {
  id             String   @id @default(cuid())
  journalAuditId String   @unique
  journalAudit   JournalAudit @relation(fields: [journalAuditId], references: [id])
  traiteParId    String
  traitePar      User     @relation(fields: [traiteParId], references: [id])
  reponse        String
  date           DateTime @default(now())

  @@schema("public")
}

// Correspond a F-AUD-03 du pack ("Detection d'anomalies d'acces"). Version
// reduite et volontaire : detection a la demande (au chargement de l'ecran
// admin), pas une tache planifiee horaire comme le demande le pack, pour ne
// pas dependre du planificateur de F-PIL-07 (src/modules/pilotage/planificateur.ts,
// proprietaire d'une autre session ce soir). 4 des 7 regles du pack sont
// honnetement calculables a partir des donnees JournalAudit existantes sans
// ajouter de journalisation ailleurs dans le depot (acces d'urgence
// frequents, connexions multi-IP, nom de famille identique, dossiers
// distincts eleves) ; les 3 autres (recherches sans resultat, acces
// refuses, arrivees verifiees "sur piece") supposeraient de journaliser de
// nouveaux evenements a travers de nombreux fichiers, hors de portee ce
// soir. Cle (regle, utilisateurId) plutot qu'un lien vers une seule ligne
// JournalAudit : chaque signalement est un agregat sur plusieurs entrees,
// pas un evenement individuel. Une detection deja ouverte (statut "nouveau")
// pour le meme (regle, utilisateurId) n'est jamais dupliquee.
model SignalementAnomalieAcces {
  id            String    @id @default(cuid())
  // acces_urgence_frequents | connexions_ip_multiples | nom_famille_identique | dossiers_distincts_eleves
  regle         String
  utilisateurId String
  utilisateur   User      @relation("UtilisateurSignale", fields: [utilisateurId], references: [id])
  detail        String
  dateDetection DateTime  @default(now())
  // nouveau | ferme
  statut        String    @default("nouveau")
  commentaire   String?
  reviewerId    String?
  reviewer      User?     @relation("ReviewerSignalement", fields: [reviewerId], references: [id])
  dateRevue     DateTime?

  @@index([statut])
  @@schema("public")
}

// Correspond a F-ADM-04 du pack ("Gerer les referentiels"), perimetre reduit
// a un seul referentiel concret (vaccins) parmi les sept listes par le pack
// (CIM-10, medicaments, examens, vaccins, motifs de rendez-vous, jours
// feries, modeles de SMS) : voir docs/audit-cote-administration.md pour le
// detail des limites assumees. RG-ADM-20 : desactivation seule, jamais de
// suppression d'une entree deja utilisee par une vraie Vaccination (le nom
// reste la cle metier lue par Vaccination.vaccin, jamais une cle etrangere,
// pour ne jamais bloquer une vaccination "Autre" en texte libre ni une
// entree desactivee entre-temps). RG-ADM-21 (versionnement) hors perimetre :
// aucun historique de version, seulement l'etat courant.
model VaccinReferentiel {
  id               String   @id @default(cuid())
  nom              String   @unique
  ordre            Int      @default(0)
  actif            Boolean  @default(true)
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@schema("public")
}

// F-ETA-05 du pack (chapitre 9, "Definir les agendas"). Perimetre reduit et
// documente comme tel (voir docs/coordination-agents.md, point F-ETA-05) :
// disponibilite hebdomadaire RECURRENTE par professionnel, sans notion de
// service distincte (ce depot n'a pas de modele Service), sans duree de
// creneau ni capacite variable (capacite 1 fixe, un seul rendez-vous par
// professionnel/date/heure), sans generation physique de creneaux (verifie a
// la volee a la creation du rendez-vous), sans fermetures ponctuelles ni
// jours feries (RG-ETA-42 hors perimetre), sans role RECEPTIONIST (absent
// des 8 roles de ce depot). heureDebutMinutes/heureFinMinutes sont exprimees
// en minutes depuis minuit, heure LOCALE Africa/Porto-Novo (RG-ETA-43 : ce
// fuseau est fixe UTC+1 sans heure d'ete, donc un entier simple suffit, pas
// besoin de stocker un fuseau).
model CreneauDisponibilite {
  id                String             @id @default(cuid())
  professionnelId   String
  professionnel     ProfessionnelSante @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  // 0 = dimanche ... 6 = samedi (meme convention que Date.getUTCDay(), a
  // interpreter cote lecture par rapport au jour LOCAL Porto-Novo, pas UTC).
  jourSemaine       Int
  heureDebutMinutes Int
  heureFinMinutes   Int
  dateCreation      DateTime           @default(now())

  @@index([professionnelId, jourSemaine])
  @@schema("public")
}

// F-AUTH-09 du pack ("Gerer ses appareils et sessions"). Chaque connexion
// reussie cree une ligne ici, dont l'id est embarque dans le JWT de session
// (src/lib/session.ts) : permet de fermer UNE session precise sans affecter
// les autres, contrairement a un simple compteur de version global. Limite
// assumee : pas de geolocalisation IP (necessiterait un service externe
// tiers, hors de portee sans accord explicite) : adresseIp technique
// affichee telle quelle, jamais de "ville approximative" inventee.
model SessionActive {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appareil         String
  navigateur       String
  adresseIp        String
  dateCreation     DateTime @default(now())
  derniereActivite DateTime @default(now())

  @@index([userId])
  @@schema("public")
}

// F-AUTH-06 (RG-AUTH-51) : codes de secours de la double authentification, dix par
// compte, a usage unique. Seule l'empreinte HMAC est stockee, jamais le code.
// utiliseLe est renseigne a la premiere utilisation (mise a jour conditionnelle).
model CodeSecoursMfa {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  empreinte String
  utiliseLe DateTime?
  creeLe    DateTime  @default(now())

  @@index([userId, empreinte])
  @@schema("public")
}

// F-AUTH-01 (RG-AUTH-03, RG-AUTH-04) : inscription en attente de verification du code
// envoye par e-mail. Le compte n'est cree qu'apres la saisie du bon code. Aucun mot
// de passe en clair : seul le hash bcrypt est conserve, comme le code. Les lignes
// expirees sont purgees a chaque nouvelle demande.
model InscriptionEnAttente {
  id                String   @id @default(cuid())
  email             String
  telephone         String
  nom               String
  prenom            String
  dateNaissance     DateTime
  sexe              String
  motDePasseHash    String
  conditionsVersion String
  codeHash          String
  essais            Int      @default(0)
  envois            Int      @default(1)
  dernierEnvoiLe    DateTime @default(now())
  dateCreation      DateTime @default(now())
  expireLe          DateTime

  @@index([email])
  @@index([expireLe])
  @@schema("public")
}

// F-ADM-04 du pack ("Gerer les referentiels"), 3e referentiel administrable
// concret parmi les sept listes (apres vaccins, medicaments), meme principe :
// remplace le tableau statique historique REFERENTIEL_EXAMENS
// (src/modules/laboratoire/referentiel-examens.ts). Nom distinct de
// l'interface TypeScript ExamenReferentiel deja existante dans ce meme
// fichier (structuration de la SAISIE, aucun lien avec ce modele Prisma) :
// "Admin" evite toute collision de nom en TypeScript pour qui importerait
// les deux dans le meme fichier.
// RG-ADM-20 (desactivation seule, jamais suppression) : ExamenMedical.typeExamen
// reste un simple texte libre (aucune cle etrangere vers ce referentiel),
// pour ne jamais bloquer un examen deja enregistre ni un futur "Autre" en
// texte libre. RG-ADM-21 (versionnement) hors perimetre, meme limite assumee
// que les 2 referentiels precedents.
model ExamenReferentielAdmin {
  id               String   @id @default(cuid())
  code             String   @unique
  libelle          String
  famille          String
  ordre            Int      @default(0)
  actif            Boolean  @default(true)
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@schema("public")
}

// F-NOT-04 du pack ("Catalogue des notifications", docs/pack claude/specs/17-fiches-notifications.md)
// et 4e referentiel administrable du pack F-ADM-04 (modeles de
// notifications/SMS, apres vaccins, medicaments, examens), meme principe.
// Seme depuis CATALOGUE_NOTIFICATIONS_DEFAUT
// (src/modules/notification/catalogue-defaut.ts), qui reprend a l'identique
// le tableau du pack (24 codes N-*).
// Perimetre volontairement reduit (limite assumee, voir
// src/modules/administration/referentiel-notifications.ts) : seul le texte
// du modele SMS et l'etat actif/inactif sont administrables ; declencheur,
// destinataire et canaux restent informatifs (documentation du catalogue,
// pas des parametres consommes par un envoi reel). Aucun appelant existant
// (creerNotification, envoyerSms, OTP...) ne lit encore cette table : la
// migration des ~13 appels existants vers ce catalogue est un chantier
// transverse hors perimetre de cette nuit.
// RG-ADM-20 (desactivation seule, jamais suppression) : meme principe que
// les 3 referentiels precedents.
model ModeleNotification {
  id               String   @id @default(cuid())
  code             String   @unique
  declencheur      String
  destinataire     String
  canaux           String
  texteModele      String   @default("")
  ordre            Int      @default(0)
  actif            Boolean  @default(true)
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@schema("public")
}

// F-ADM-04 du pack, 5e referentiel administrable : jours feries nationaux
// (RG-ETA-42 : ils ne generent pas de creneau de rendez-vous). Une ligne par
// date (jour civil, colonne DATE, sans fuseau) ; le jour civil d'un instant
// est celui du Benin, UTC+1 (voir src/modules/administration/jours-feries-calcul.ts).
// RG-ADM-20 : desactivation seule, jamais suppression. "source" distingue les
// dates generees (fixes et fetes chretiennes mobiles) des dates saisies a la
// main (fetes musulmanes, jours exceptionnels). RG-ADM-21 (versionnement) hors
// perimetre, meme limite assumee que les referentiels precedents.
model JourFerie {
  id               String   @id @default(cuid())
  date             DateTime @unique @db.Date
  libelle          String
  actif            Boolean  @default(true)
  source           String   @default("saisie")
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@schema("public")
}

// F-ADM-05 / RG-ADM-30 du pack ("pending_admin_actions") : toute action sur un
// compte d'administrateur doit etre confirmee par un SECOND administrateur
// (principe des quatre yeux). L'action demandee reste "en_attente" ici tant
// qu'un autre administrateur ne l'a pas approuvee ou refusee, ou jusqu'a son
// expiration. Ids en simples chaines (aucune cle etrangere) : la trace doit
// survivre a toute evolution des comptes. Jamais de mot de passe ni de secret
// dans `parametres` (motif, coordonnees d'une invitation seulement).
// Voir src/modules/administration/gestion-comptes-nationale.ts.
model ActionAdministrateurEnAttente {
  id            String    @id @default(cuid())
  // suspension | reactivation | reinitialisation_2fa | invitation_admin
  type          String
  // Compte vise ; null pour une invitation (le compte n'existe pas encore).
  cibleUserId   String?
  parametres    Json
  demandeParId  String
  // en_attente | approuvee | refusee | expiree
  statut        String    @default("en_attente")
  decideParId   String?
  motifDecision String?
  dateDemande   DateTime  @default(now())
  dateDecision  DateTime?
  expireLe      DateTime

  @@index([statut, expireLe])
  @@schema("public")
}

// F-ADM-01 du pack : etat technique du tableau de bord administrateur ("derniere
// execution des taches planifiees", "erreurs des 24 h"). Une ligne par
// execution d'une tache planifiee en process (purge des notifications, remise
// des SMS differes, relances du laboratoire, rappels de rendez-vous, marquage
// des absences), ecrite par src/modules/administration/executions-taches.ts.
// `message` ne contient jamais de donnee de sante ni de stack : uniquement le
// nom de l'erreur et un message technique tronque. Purge a 30 jours.
model ExecutionTache {
  id            String   @id @default(cuid())
  tache         String
  // ok | erreur
  statut        String
  // Nombre d'elements traites (relances envoyees, SMS remis...), null si inconnu.
  nombreTraite  Int?
  message       String?
  date          DateTime @default(now())

  @@index([tache, date])
  @@index([statut, date])
  @@schema("public")
}

// F-CIT-05 du pack (carte sante numerique), RG-CIT-40 : jeton de presence de
// 5 minutes et a usage unique, desormais en base (l'ancien magasin en memoire
// se perdait a chaque redemarrage et ne fonctionnait pas a plusieurs
// instances). Seule l'empreinte SHA-256 du jeton est stockee : un jeton ne se
// relit jamais. Voir src/modules/patient/carte-sante.ts.
model JetonCarteSante {
  id           String    @id @default(cuid())
  jetonHash    String    @unique
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expireLe     DateTime
  consommeLe   DateTime?
  dateCreation DateTime  @default(now())

  @@index([patientId])
  @@schema("public")
}

// F-ADM-04 du pack : referentiels administrables "listes simples" (services,
// types d'etablissement, specialites...), une seule table discriminee par
// "type" plutot qu'une table par liste. RG-ADM-20 : desactivation seule,
// jamais suppression. RG-ADM-21 (versionnement) hors perimetre. Voir
// src/modules/administration/referentiels-simples.ts.
model ReferentielSimple {
  id               String   @id @default(cuid())
  type             String
  code             String
  libelle          String
  ordre            Int      @default(0)
  actif            Boolean  @default(true)
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@unique([type, code])
  @@schema("public")
}

// F-ADM-04 du pack : sous-liste CIM-10 administrable (diagnostics courants),
// avec groupe de maladies et indicateur de code sensible (RG-PIL-05,
// RG-CLI-52). Table dediee (recherche par code ou libelle, colonnes typees)
// et non ReferentielSimple. Voir src/modules/administration/referentiel-cim10.ts.
model DiagnosticCim10 {
  id               String   @id @default(cuid())
  code             String   @unique
  libelle          String
  chapitre         String   @default("")
  groupeMaladie    String   @default("")
  sensible         Boolean  @default(false)
  actif            Boolean  @default(true)
  dateCreation     DateTime @default(now())
  dateModification DateTime @default(now())

  @@index([groupeMaladie])
  @@schema("public")
}

// F-IA-01 et F-IA-05 du pack (chapitre 16), RG-IA-08 : une ligne par appel a
// l'IA, SANS le texte envoye ni la reponse. Le patient est un identifiant simple
// (pas de relation) pour que le journal survive a une suppression de dossier.
// Le commentaire de retour est efface a 30 jours (voir src/modules/ai/journal.ts).
model AppelIa {
  id                String   @id @default(cuid())
  utilisateurId     String
  patientId         String?
  // resume_dossier (F-IA-01) ; les autres fonctionnalites d'IA s'y ajouteront.
  fonctionnalite    String
  modele            String
  versionConsigne   String
  nombreSources     Int      @default(0)
  pucesLues         Int      @default(0)
  pucesSupprimees   Int      @default(0)
  dureeMs           Int      @default(0)
  // ok | indisponible | bloque | erreur
  statut            String
  // utile | inexact, null tant que le medecin n'a pas donne son retour.
  retour            String?
  commentaireRetour String?
  date              DateTime @default(now())

  @@index([fonctionnalite, date])
  @@index([utilisateurId, fonctionnalite, date])
  @@schema("public")
}
