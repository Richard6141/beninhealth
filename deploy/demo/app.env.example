# Environnement de l'application sur le serveur de démonstration : /opt/beninhealth/app.env,
# lisible par son seul propriétaire (chmod 600). Aucune valeur réelle ici.
# La base est le service « db » du projet compose (jamais publiée hors de l'hôte).
DATABASE_URL=postgresql://beninhealth:<mot-de-passe-de-.env>@db:5432/beninhealth?schema=public
# openssl rand -base64 48
NEXTAUTH_SECRET=<secret>
NODE_ENV=production
# Code de connexion affiché à l'écran pour les seuls comptes @benin-health.test.
DEMO_CODE_ECRAN=1

SMTP_HOST=A_REMPLIR
SMTP_PORT=A_REMPLIR
SMTP_SECURE=A_REMPLIR
SMTP_USER=A_REMPLIR
SMTP_PASSWORD=A_REMPLIR
SMTP_FROM=A_REMPLIR
CLOUDINARY_URL=A_REMPLIR
CLOUDINARY_CLOUD_NAME=A_REMPLIR
CLOUDINARY_API_KEY=A_REMPLIR
CLOUDINARY_API_SECRET=A_REMPLIR
CLOUDINARY_FOLDER=A_REMPLIR
WAPY_PONT_CLE=A_REMPLIR
WAPY_NUMEROS_TEST=A_REMPLIR
